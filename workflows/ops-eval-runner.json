      "id": "67744e19-1ae3-4710-9c30-e62f44f98b70",
      "name": "Redact (eval)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1728,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $('Settings').first().json;\nconst calls = $('Case calls').all().map((i) => i.json);\nreturn $input.all().map((item, i) => ({\n  json: { ...calls[i], vars: { ...calls[i].vars, [s.redactField]: item.json.redacted }, redacted: item.json.redacted },\n}));"
      },
      "id": "47f01b3c-f0b6-4d03-b690-d703e9f677df",
      "name": "Apply redaction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1968,
        304
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "zZg12dJCMDaRMDDv",
          "mode": "list",
          "cachedResultUrl": "/workflow/zZg12dJCMDaRMDDv",
          "cachedResultName": "Ops: AI Gateway"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "each",
        "options": {}
      },
      "id": "7c16f67a-7032-41ea-a0f1-7322bed3170b",
      "name": "Assess (eval)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2224,
        416
      ]
    },
    {
      "parameters": {
        "jsCode": "const c = $('Each case').first().json;\nconst results = $input.all().map((i) => i.json);\nconst cost = results.reduce((a, r) => a + (r.costUsd || 0), 0);\n\n// expected values: a list = \"any of these\"; {min,max} = a number range; anything else = exact match\nconst matches = (exp, got) =>\n  Array.isArray(exp) ? exp.includes(got)\n  : exp && typeof exp === 'object' ? typeof got === 'number' && got >= exp.min && got <= exp.max\n  : got === exp;\n\nif (c.kind === 'expected') {\n  const r = results[0];\n  const mismatches = !r.ok\n    ? [`invalid output: ${r.error}`]\n    : Object.entries(c.expected || {})\n        .filter(([k, exp]) => !matches(exp, r.value[k]))\n        .map(([k, exp]) => `${k}: expected ${JSON.stringify(exp)}, got ${JSON.stringify(r.value[k])}`);\n  return [{ json: { caseId: c.case_id, kind: 'expected', pass: mismatches.length === 0, mismatches, cost } }];\n}\n\n// Pair: both halves must get the same result.\nconst [a, b] = results;\nlet redactedIdentical = null;\ntry {\n  const texts = $('Apply redaction').all().map((i) => i.json.redacted);\n  redactedIdentical = texts[0] === texts[1];\n} catch { /* no redaction in this eval */ }\nconst problems = [];\nif (!a.ok || !b.ok) problems.push('invalid output');\nelse {\n  const diff = Math.abs(a.value.overall_score - b.value.overall_score);\n  if (diff > 0.5) problems.push(`scores differ by ${diff}`);\n  if (a.value.recommendation !== b.value.recommendation) problems.push(`recommendations differ: ${a.value.recommendation} vs ${b.value.recommendation}`);\n}\nif (redactedIdentical === false) problems.push('redacted texts differ: redaction missed a difference');\nreturn [{ json: { caseId: c.case_id, kind: 'pair', pass: problems.length === 0, mismatches: problems, cost, redactedIdentical } }];"
      },
      "id": "7bb5a817-edd9-4f55-8d0a-8059c918931e",
      "name": "Score case",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        416
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $('Settings').first().json;\nconst threshold = $('Load cases').first().json.threshold ?? 0.85;\nconst rows = $input.all().map((i) => i.json);\nconst expected = rows.filter((r) => r.kind === 'expected');\nconst pairs = rows.filter((r) => r.kind === 'pair');\nconst accuracy = expected.length ? expected.filter((r) => r.pass).length / expected.length : 1;\nconst pairsFailed = pairs.filter((r) => !r.pass).length;\nconst passed = accuracy >= threshold && pairsFailed === 0;\nconst cost = rows.reduce((a, r) => a + r.cost, 0);\nreturn [{\n  json: {\n    summary: `${passed ? 'PASSED' : 'FAILED'}: ${s.automationId} ${s.promptVersion}. Accuracy ${(accuracy * 100).toFixed(0)}% (needs ${(threshold * 100).toFixed(0)}%), paired tests failed: ${pairsFailed}, cost $${cost.toFixed(4)}`,\n    params: [s.automationId, s.promptVersion, rows.length, accuracy, pairsFailed, passed,\n             JSON.stringify({ cost, failures: rows.filter((r) => !r.pass) })],\n  },\n}];"
      },
      "id": "54eb2560-591a-473a-9e0b-67660cb50a9b",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
