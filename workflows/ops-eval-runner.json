    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.case_id, c.kind, c.input, c.expected, a.eval_threshold::float AS threshold\nFROM eval_cases c JOIN automations a ON a.id = c.automation_id\nWHERE c.automation_id = $1\nORDER BY c.case_id;",
        "options": {
          "queryReplacement": "={{ [ $json.automationId ] }}"
        }
      },
