      "position": [
        736,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $('Settings').first().json;\nconst c = $input.first().json;\nconst varsList = c.kind === 'pair' ? [c.input.a, c.input.b] : [c.input];\nreturn varsList.map((vars, slot) => ({\n  json: { slot, automationId: s.automationId, promptName: s.promptName, promptVersion: s.promptVersion, vars },\n}));"
      },
