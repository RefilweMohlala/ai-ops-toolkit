  "nodes": [
    {
      "parameters": {
        "content": "## Ops: Review Decision (must be ACTIVE)\nGET /webhook/ops-review. The email link only shows a confirmation page. The decision is recorded only when the reviewer clicks Confirm, so email link scanners can't approve or reject by accident (Fix 3).\nOnly the first confirmation wins.",
        "height": 180,
        "width": 600
      },
      "id": "364de574-346c-4cf0-b1fa-4fe2b8affbb1",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "path": "ops-review",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "9b31e0ba-57ab-456d-8d6f-d5f646ecac81",
      "name": "Review link",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        16,
        368
      ],
      "webhookId": "f30c1f0b-13f2-5932-8c48-9c4baef7bc46"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst q = $input.first().json.query || {};\nconst id = parseInt(q.id, 10);\nconst d = q.d;\nconst sign = (s) => crypto.createHmac('sha256', $env.REVIEW_LINK_SECRET).update(s).digest('hex').slice(0, 32);\nconst same = (a, b) => typeof a === 'string' && typeof b === 'string' && a.length === b.length && crypto.timingSafeEqual(Buffer.from(a), Buffer.from(b));\n\n// The link from the email must be valid.\nconst linkOk = Number.isInteger(id) && ['approve', 'reject'].includes(d) && same(q.t, sign(`${id}:${d}`));\n// The confirm link (shown on the confirmation page) carries a second signed token, c.\nconst confirmToken = linkOk ? sign(`${id}:${d}:confirm`) : null;\nconst confirmed = linkOk && same(q.c, confirmToken);\nreturn [{\n  json: {\n    step: !linkOk ? 'invalid' : confirmed ? 'record' : 'ask',\n    id,\n    d,\n    decision: d === 'approve' ? 'approved' : 'rejected',\n    reviewer: 'email-link',\n    confirmLink: linkOk ? `${$env.N8N_PUBLIC_URL}/webhook/ops-review?id=${id}&d=${d}&t=${q.t}&c=${confirmToken}` : null,\n  },\n}];"
      },
      "id": "cbdf46ce-5d1d-4285-a51a-a72266292f06",
      "name": "Verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
