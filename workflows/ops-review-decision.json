      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html>\n<html><body style=\"font-family:sans-serif;max-width:32rem;margin:3rem auto\">\n<h3>Confirm your decision</h3>\n<p>You are about to <b>{{ $json.d }}</b> review item #{{ $json.id }}.</p>\n<p><a href=\"{{ $json.confirmLink }}\" style=\"display:inline-block;padding:.6rem 1.2rem;background:#222;color:#fff;text-decoration:none\">Confirm {{ $json.d }}</a></p>\n<p style=\"color:#666\">Nothing happens until you click Confirm. If you didn't expect this email, close this page.</p>\n</body></html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
